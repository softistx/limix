{
	"name": "limix",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"examples/*"
	],
	"scripts": {
		"build": "bun run --filter './packages/*' build",
		"typecheck": "bun run typecheck:scripts && bun run --filter './packages/*' typecheck && bun run --filter './examples/*' typecheck",
		"typecheck:scripts": "bun check -p scripts/tsconfig.json",
		"test": "bun run --filter './packages/*' test && bun run --filter './examples/*' test && bun test ./scripts/",
		"fix": "biome check",
		"changeset": "changeset",
		"changeset:version": "changeset version && bun install --lockfile-only",
		"changeset:publish": "bun run build && bun run scripts/publish.ts",
		"verify:artifacts": "bun run scripts/verify-artifacts.ts",
		"changeset:private": "bun run scripts/check-changesets.ts",
		"changeset:status": "changeset status --since=origin/develop"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.9",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.1.0",
		"@changesets/parse": "^1.1.0",
		"@types/bun": "^1.4.5",
		"hono": "^4.13.23",
		"path-to-regexp": "^8.4.2",
		"typescript": "~7.0.2",
		"yaml": "^2.9.1"
	},
	"overrides": {
		"typescript": "~7.0.2"
	},
	"packageManager": "bun@1.4.5"
}
