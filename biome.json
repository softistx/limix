{
	"$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "develop"
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!**/dist", "!!.claude/worktrees"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"markdown": { "formatter": { "enabled": false } },
	"yaml": { "formatter": { "enabled": false } },
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
