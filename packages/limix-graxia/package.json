{
	"name": "@softistx/limix-graxia",
	"version": "0.3.0",
	"description": "The graxia and graphql-js integration of @softistx/limix: field guard, plugin, coverage, @needs checks",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./operations": {
			"types": "./dist/operations/index.d.ts",
			"import": "./dist/operations/index.js",
			"default": "./dist/operations/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"policy",
		"authorization",
		"graphql",
		"graxia",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/limix.git",
		"directory": "packages/limix-graxia"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "restricted"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test ./src/",
		"typecheck": "bun check"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts",
			"src/operations/index.ts"
		]
	},
	"devDependencies": {
		"@softistx/graxia": "^0.18.0",
		"@softistx/limix": "workspace:^",
		"@types/bun": "^1.4.5",
		"graphql": "^17.1.0"
	},
	"peerDependencies": {
		"@softistx/graxia": ">=0.18.0 <1.0.0",
		"@softistx/limix": "workspace:^",
		"graphql": "^17.1.0",
		"typescript": "^6.0.3 || ^7.0.0"
	}
}
