{
	"name": "@softistx/limix-publish",
	"version": "0.1.2",
	"description": "The emitter of @softistx/limix remote rules: signs a rules file as a JWS, serves it and its JWKS (API and CLI)",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"limix-publish": "./dist/cli/main.js"
	},
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"policy",
		"authorization",
		"jws",
		"jwks",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/limix.git",
		"directory": "packages/limix-publish"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "restricted"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test ./src/",
		"typecheck": "bun check"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts",
			"src/cli/main.ts"
		]
	},
	"dependencies": {
		"jose": "^6.2.18"
	},
	"devDependencies": {
		"@softistx/limix": "workspace:^",
		"@types/bun": "^1.4.5"
	},
	"peerDependencies": {
		"@softistx/limix": "workspace:^",
		"typescript": "^6.0.3 || ^7.0.0"
	}
}
