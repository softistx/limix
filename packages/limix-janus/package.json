{
	"name": "@softistx/limix-janus",
	"version": "0.2.1",
	"description": "The RelationChecker adapter of @softistx/limix over janus permissions",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"policy",
		"authorization",
		"relations",
		"janus",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/limix.git",
		"directory": "packages/limix-janus"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "restricted"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test ./src/",
		"typecheck": "bun check"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts"
		]
	},
	"devDependencies": {
		"@softistx/janus": "^0.84.0",
		"@softistx/limix": "workspace:^",
		"@types/bun": "^1.4.5"
	},
	"peerDependencies": {
		"@softistx/janus": ">=0.84.0 <1.0.0",
		"@softistx/limix": "workspace:^",
		"typescript": "^6.0.3 || ^7.0.0"
	}
}
