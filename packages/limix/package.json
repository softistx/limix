{
	"name": "@softistx/limix",
	"version": "0.0.0",
	"private": true,
	"description": "A policy engine for REST and GraphQL: rules, relations through a port, coverage, signed remote rules",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"schema",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./rules.schema.json": "./schema/rules.schema.json",
		"./package.json": "./package.json"
	},
	"keywords": [
		"policy",
		"authorization",
		"rest",
		"graphql",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/limix.git",
		"directory": "packages/limix"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "restricted"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test ./src/",
		"typecheck": "bun check",
		"schema:gen": "bun run scripts/generate-schema.ts && biome check --write schema/rules.schema.json"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts"
		]
	},
	"devDependencies": {
		"@types/bun": "^1.4.5"
	},
	"peerDependencies": {
		"typescript": "^6.0.3 || ^7.0.0"
	},
	"dependencies": {
		"path-to-regexp": "^8.4.2",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	}
}
